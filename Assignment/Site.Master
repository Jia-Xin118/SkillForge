<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="Assignment.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SkillForge</title>
    
    <!-- Bootstrap CSS - Using CDN for reliability -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- EXTERNAL CSS -->
    <link href="~/CustomStyles.css" rel="stylesheet" type="text/css" runat="server" />
    
    <!-- INTERNAL CSS - Force dark theme -->
    <style type="text/css">
        /* Force dark theme immediately */
        html, body { 
            background-color: #1a1a1a !important; 
            color: #ffffff !important;
            font-family: 'Source Sans Pro', sans-serif !important;
            height: 100%;
            margin: 0;
            padding: 0;
        }
        
        /* Navbar styling */
        .navbar {
            background-color: #000000 !important;
            border-bottom: 3px solid #a51c30 !important;
            padding: 15px 0 !important;
        }
        
        .navbar-brand {
            color: #ffffff !important;
            font-weight: bold !important;
            font-size: 24px !important;
        }
        
        .navbar-brand:hover {
            color: #a51c30 !important;
        }
        
        .nav-link {
            color: #ffffff !important;
            font-weight: 500 !important;
            padding: 10px 15px !important;
        }
        
        .nav-link:hover {
            color: #a51c30 !important;
        }
        
        /* Dropdown menu */
        .dropdown-menu {
            background-color: #000000 !important;
            border: 1px solid #333 !important;
            padding: 10px 0 !important;
        }
        
        .dropdown-item {
            color: #ffffff !important;
            padding: 8px 20px !important;
        }
        
        .dropdown-item:hover {
            background-color: #a51c30 !important;
            color: #ffffff !important;
        }
        
        .dropdown-divider {
            border-top: 1px solid #333 !important;
        }
        
        /* Main content area */
        .body-content {
            background-color: #1a1a1a !important;
            min-height: calc(100vh - 200px);
            padding: 30px 0;
        }
        
        /* Login form in navbar */
        .nav-login {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        
        .nav-login-input {
            background-color: #333 !important;
            border: 1px solid #555 !important;
            color: #fff !important;
            padding: 8px 12px;
            border-radius: 4px;
            width: 130px;
            font-size: 14px;
        }
        
        .nav-login-input:focus {
            outline: none;
            border-color: #a51c30 !important;
        }
        
        .nav-login-btn {
            background-color: #a51c30 !important;
            color: white !important;
            border: none !important;
            padding: 8px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
        }
        
        .nav-login-btn:hover {
            background-color: #7a1524 !important;
        }
        
        /* Progress bar */
        .nav-progress {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            background-color: #222;
            padding: 5px 15px;
            border-radius: 20px;
        }
        
        .nav-level {
            font-weight: bold;
            color: #a51c30;
            font-size: 14px;
        }
        
        .nav-progress-bar-bg {
            width: 100px;
            height: 8px;
            background-color: #333;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .nav-progress-bar-fill {
            height: 100%;
            background-color: #a51c30;
            transition: width 0.3s ease;
        }
        
        .nav-progress-text {
            font-size: 12px;
            color: #ccc;
        }
        
        /* Footer */
        footer {
            background-color: #000000 !important;
            color: #666 !important;
            border-top: 1px solid #333 !important;
            padding: 25px 0 !important;
            margin-top: 0 !important;
        }
        
        /* Featured insight section */
        .featured-insight {
            background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
            padding: 50px;
            border-radius: 12px;
            margin: 20px 0 40px 0;
            border-left: 6px solid #a51c30;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .featured-insight h2 {
            color: #a51c30;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
            font-weight: 600;
        }
        
        .featured-insight h1 {
            font-size: 42px;
            margin-bottom: 20px;
            font-weight: 700;
            line-height: 1.2;
        }
        
        .featured-insight p {
            color: #ccc;
            font-size: 18px;
            line-height: 1.6;
            max-width: 700px;
            margin-bottom: 25px;
        }
        
        .view-cert-btn {
            background-color: transparent;
            border: 2px solid #a51c30;
            color: #a51c30;
            padding: 12px 30px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .view-cert-btn:hover {
            background-color: #a51c30;
            color: #fff;
        }
        
        /* Table styles for admin pages */
        .table { 
            background-color: #2d2d2d !important; 
            color: #ffffff !important; 
            border-radius: 8px;
            overflow: hidden;
        }
        .table th { 
            background-color: #000000 !important; 
            color: #ffffff !important; 
            border-color: #414141 !important;
            font-weight: 600;
        }
        .table td { 
            border-color: #414141 !important;
            vertical-align: middle;
        }
        .table-striped > tbody > tr:nth-of-type(odd) { 
            background-color: #252525 !important; 
        }
        
        /* Cards */
        .card {
            background-color: #2d2d2d !important;
            border: 1px solid #414141 !important;
            color: #fff !important;
        }
        
        /* Buttons */
        .btn-primary {
            background-color: #a51c30 !important;
            border-color: #a51c30 !important;
        }
        
        .btn-primary:hover {
            background-color: #7a1524 !important;
            border-color: #7a1524 !important;
        }
        
        .btn-outline-primary {
            border-color: #a51c30 !important;
            color: #a51c30 !important;
        }
        
        .btn-outline-primary:hover {
            background-color: #a51c30 !important;
            color: #fff !important;
        }
        
        /* Links */
        a { 
            color: #a51c30 !important; 
            text-decoration: none;
        }
        a:hover { 
            color: #ffffff !important; 
            text-decoration: underline !important; 
        }
    </style>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@300;400;600;700&display=swap" rel="stylesheet" />
</head>

<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebParts/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" runat="server" href="~/">SkillForge</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        
                        <%-- CATEGORIES DROPDOWN --%>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" 
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categories
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="categoriesDropdown">
                                <asp:Repeater ID="RepeaterCategories" runat="server">
                                    <ItemTemplate>
                                        <li>
                                            <a class="dropdown-item" 
                                               href='Modules.aspx?cat=<%# Server.UrlEncode(Eval("Category").ToString()) %>'>
                                                <%# Eval("Category") %>
                                            </a>
                                        </li>
                                    </ItemTemplate>
                                </asp:Repeater>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="Modules.aspx">All Modules</a></li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/About.aspx">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Contact.aspx">Contact</a>
                        </li>
                    </ul>
                    
                    <%-- Right side items --%>
                    <ul class="navbar-nav ms-auto align-items-center">
                        <% if (Session["UserID"] == null) { %>
                            <%-- LOGIN FORM --%>
                            <li class="nav-item">
                                <div class="nav-login">
                                    <asp:TextBox ID="txtNavEmail" runat="server" placeholder="Email" CssClass="nav-login-input"></asp:TextBox>
                                    <asp:TextBox ID="txtNavPassword" runat="server" TextMode="Password" placeholder="Password" CssClass="nav-login-input"></asp:TextBox>
                                    <asp:Button ID="BtnNavLogin" runat="server" Text="Login" OnClick="BtnNavLogin_Click" CssClass="nav-login-btn" />
                                </div>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="nav-link" runat="server" href="~/Register.aspx">Register</a>
                            </li>
                        <% } else { %>
                            <%-- ADMIN LINK (for admin users) --%>
                            <% if (Session["Role"] != null && Session["Role"].ToString() == "Admin") { %>
                                <li class="nav-item">
                                    <a class="nav-link" runat="server" href="~/AdminModules.aspx">Manage Modules</a>
                                </li>
                            <% } %>
                            
                            <%-- PROFILE --%>
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/Profile.aspx">My Profile</a>
                            </li>
                            
                            <%-- PROGRESS BAR --%>
                            <li class="nav-item">
                                <div class="nav-progress">
                                    <span class="nav-level">LEVEL <asp:Label ID="lblLevel" runat="server" Text="1"></asp:Label></span>
                                    <div class="nav-progress-bar-bg">
                                        <div id="progressBarNav" runat="server" class="nav-progress-bar-fill" style="width: 0%"></div>
                                    </div>
                                    <span class="nav-progress-text"><asp:Label ID="lblProgressText" runat="server" Text="0/3 XP"></asp:Label></span>
                                </div>
                            </li>
                            
                            <li class="nav-item ms-2">
                                <a class="nav-link" runat="server" href="~/Logout.aspx">Logout</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
        
        <!-- Main Content Container -->
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                <!-- Default featured insight content (shown on home page) -->
                <div class="featured-insight">
                    <h2>FEATURED INSIGHT · JANUARY 2026</h2>
                    <h1>The Future of Leadership<br />in a Digital Age</h1>
                    <p>How top executives are adapting to AI-driven decision making and remote team management. Master the essential skills that separate successful leaders from the rest.</p>
                    <button class="view-cert-btn" onclick="window.location.href='Certifications.aspx'">VIEW CERTIFICATIONS</button>
                </div>
            </asp:ContentPlaceHolder>
        </div>
        
        <!-- Footer -->
        <footer class="text-center">
            <div class="container">
                <p>&copy; <%: DateTime.Now.Year %> - SkillForge | Group Assignment - APU</p>
            </div>
        </footer>
    </form>
    
    <!-- Bootstrap JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Optional: Custom JavaScript -->
    <script type="text/javascript">
        // Enable all Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
</body>
</html>