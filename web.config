<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Keep your existing system.web configuration here; ensure targetFramework matches your project -->
    <compilation debug="true" targetFramework="4.7.2" />
    <!-- other existing settings preserved -->
  </system.web>

  <!-- Replace or add this system.codedom section to avoid the missing Microsoft.VisualBasic provider error.
       Option A (recommended): use Roslyn-based providers (requires Microsoft.CodeDom.Providers.DotNetCompilerPlatform NuGet).
       Option B: remove the entire system.codedom section if you don't need custom CodeDom providers.
-->
  <system.codedom>
    <compilers>
      <!-- C# provider (Roslyn-based). Keep this if your app uses C# compilation at runtime. -->
      <compiler language="c#;cs;csharp" extension=".cs" warningLevel="4"
                type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform">
        <providerOption name="CompilerVersion" value="v4.0" />
        <providerOption name="WarnAsError" value="false" />
        <!-- Optional: add compilerOptions if you need specific language versions -->
        <!-- <providerOption name="CompilerOptions" value="/langversion:latest" /> -->
      </compiler>

      <!--
      VB provider removed to avoid runtime error when the DotNetCompilerPlatform assembly is not present.
      If your application requires VB compilation at runtime, restore the VB compiler entry and ensure
      the NuGet package Microsoft.CodeDom.Providers.DotNetCompilerPlatform is installed and deployed.

      Example VB entry (uncomment only if the package is installed and assemblies are available in bin):
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4"
                type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform">
        <providerOption name="CompilerVersion" value="v4.0" />
        <providerOption name="OptionInfer" value="true" />
      </compiler>
      -->

      <!--
      Alternative legacy VB provider (use only if you don't want Roslyn package and VB compilation is needed):
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4"
                type="Microsoft.VisualBasic.VBCodeProvider, System">
        <providerOption name="CompilerVersion" value="v4.0" />
        <providerOption name="OptionInfer" value="true" />
      </compiler>
      -->
    </compilers>
  </system.codedom>

  <!-- The rest of your existing web.config sections (connectionStrings, system.webServer, etc.) should remain unchanged. -->
</configuration>